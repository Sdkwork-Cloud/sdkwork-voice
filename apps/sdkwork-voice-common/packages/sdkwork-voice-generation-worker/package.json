{
  "name": "@sdkwork/voice-generation-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork Voice generation worker that drains queued tasks through the provider adapter and backend reconcile API.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/voice-backend-sdk": "workspace:*",
    "@sdkwork/voice-contracts": "workspace:*",
    "@sdkwork/voice-provider-adapter": "workspace:*"
  },
  "sdkwork": {
    "workspace": "sdkwork-voice",
    "architecture": "common",
    "domain": "voice",
    "capability": "generation-worker",
    "status": "ready"
  }
}
