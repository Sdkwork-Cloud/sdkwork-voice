# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_voice_demo` and a
# dedicated Redis prefix `voice-demo` on a distinct logical DB index so no cache key collides with
# another env sharing the deployment Redis.
SDKWORK_VOICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_VOICE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VOICE_PROFILE_ID=cloud.demo
SDKWORK_VOICE_APPLICATION_PUBLIC_HTTP_URL=https://voice-demo.sdkwork.com
SDKWORK_VOICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
