# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_voice_demo` and a
# dedicated Redis prefix `voice-demo` on a distinct logical DB index so no cache key (session,
# rate-limit, transcription/media idempotency) collides with another env sharing the deployment Redis.
SDKWORK_VOICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_VOICE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VOICE_PROFILE_ID=standalone.demo
SDKWORK_VOICE_APPLICATION_PUBLIC_HTTP_URL=https://voice-demo.sdkwork.com
VOICE_API_BIND=127.0.0.1:8080
VITE_SDKWORK_VOICE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
