{
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-voice",
    "name": "SDKWork Voice",
    "repository": "Sdkwork-Cloud/sdkwork-voice",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-voice",
    "defaultVersion": "0.1.0",
    "channels": ["DEV", "INTERNAL", "STABLE"]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "platform": "linux",
      "architecture": "x64",
      "deploymentProfile": "standalone",
      "runtimeTarget": "server",
      "profile": "server",
      "formats": ["tar.gz"],
      "runner": "ubuntu-latest",
      "outputGlobs": ["target/release/sdkwork-api-voice-standalone-gateway"]
    },
    {
      "id": "container-x64-cloud-container-oci",
      "platform": "container",
      "architecture": "x64",
      "deploymentProfile": "cloud",
      "runtimeTarget": "container",
      "profile": "container",
      "formats": ["oci"],
      "runner": "ubuntu-latest",
      "outputGlobs": ["deployments/container/sdkwork-voice-image.tar"]
    }
  ],
  "dependencies": [
    {
      "id": "sdkwork-appbase",
      "repository": "Sdkwork-Cloud/sdkwork-appbase",
      "ref": "main",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "Sdkwork-Cloud/sdkwork-iam",
      "ref": "main",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "Sdkwork-Cloud/sdkwork-utils",
      "ref": "main",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "Sdkwork-Cloud/sdkwork-database",
      "ref": "main",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "Sdkwork-Cloud/sdkwork-drive",
      "ref": "main",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "Sdkwork-Cloud/sdkwork-web-framework",
      "ref": "main",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install dependencies",
        "shell": "bash",
        "run": "pnpm install --frozen-lockfile"
      }
    ],
    "validate": [
      {
        "name": "Run voice verification",
        "shell": "bash",
        "run": "pnpm verify"
      }
    ]
  }
}
